# Copy this file to ".env" and fill in what you need.
# (cp .env.example .env)

# Which sources to scan by default. Comma-separated.
# Options: mock | tiktok | instagram   (tiktok/instagram = OUR OWN browser scrapers)
#          tiktok_lib | instagram_lib  (fallback: third-party libraries)
SOURCES=tiktok

# Set to 0 to WATCH the browser work (useful for captchas / IG login). 1 = invisible.
BROWSER_HEADLESS=1

# Set to 0 to skip the local vision model (faster scans, caption tags only).
WATCH_VIDEOS=1
# How many videos to try to pull each scan. Higher = more trustworthy trends
# (but slower scrape). The week cap keeps only the fresh ones.
SCRAPE_LIMIT=150
# Vision model is slow (~30s/video) so it only watches the top N per scan;
# the rest get fast caption tags. Raise if your Mac can handle longer scans.
VISION_TOP_N=15

# How clothing-focused a video must be to be kept (0.0 - 1.0).
# 0.2 = broad (also catches thirst-traps / outfit-showing videos where the
#       caption isn't "about fashion"); 0.35 = normal; 0.6 = strict; 0 = keep all.
FASHION_MIN=0.2

# --- Quality gates: a video must pass ALL of these to be logged ---
# Newest-only cap: skip anything older than this many hours. 168 = 1 week.
MAX_AGE_HOURS=168
# Minimum likes (real engagement). Raise to be pickier.
MIN_LIKES=500
# Minimum velocity (engagement gained per hour). 0 = off.
MIN_VELOCITY=0
# Keep content aimed at teens / early adults (inferred from hashtags/style/words).
# 0.3 = drop clearly older-skewing (old money, workwear...); 0 = off (any audience).
MIN_YOUTH=0.3

# ---- TikTok (our own browser scraper -- no token needed!) ----
# Fashion hashtags to scan (these keep results clothing-focused).
TIKTOK_HASHTAGS=ootd,outfit,fashiontiktok,thriftflip,streetwear,grwm
# TIKTOK_MS_TOKEN is only used by the old 'tiktok_lib' fallback source.
TIKTOK_MS_TOKEN=

# ---- Instagram (our own browser scraper) ----
# IG requires a login. USE A THROWAWAY ACCOUNT, not your real one.
IG_USERNAME=
IG_PASSWORD=
IG_HASHTAGS=ootd,outfitinspo,fashionreels,styleinspo,thriftflip
IG_PER_HASHTAG=15

# Dashboard port
PORT=8775

# ---- Secrets (leave blank unless you use that source) ----
APIFY_TOKEN=
GEMINI_API_KEY=
IG_GRAPH_TOKEN=
IG_USER_ID=
